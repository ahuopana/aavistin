# Copy to .env for local development. Never commit the real .env file.
# `docker compose up` does this for you automatically (see
# scripts/generate_env.sh), filling in a random DJANGO_SECRET_KEY.

DJANGO_SECRET_KEY=change-me-to-a-random-value
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production (DEBUG=False): DJANGO_SECRET_KEY must be set to a long random value or
# the app refuses to start. Behind a TLS-terminating reverse proxy also set the
# lines below (docs/adr/0043-production-security-settings.md):
# TRUST_X_FORWARDED_PROTO=True            # only if the proxy overwrites X-Forwarded-Proto
# DJANGO_CSRF_TRUSTED_ORIGINS=https://aavistin.example.org
# SECURE_HSTS_SECONDS=31536000            # raise once HTTPS is confirmed working
# SESSION_COOKIE_AGE=43200                # seconds; default 12 hours

# Abuse limits (docs/adr/0044-throttling-and-upload-limits.md); defaults shown.
# LOGIN_THROTTLE_ENABLED=True
# LOGIN_THROTTLE_MAX_FAILURES=5           # per username, within the window
# LOGIN_THROTTLE_MAX_FAILURES_PER_IP=30
# LOGIN_THROTTLE_WINDOW_SECONDS=900
# CLIENT_IP_HEADER=HTTP_X_FORWARDED_FOR   # behind a proxy that overwrites it
# EVIDENCE_MAX_UPLOAD_BYTES=26214400
# EVIDENCE_ALLOWED_EXTENSIONS=pdf,txt,md,csv,json,xml,png,jpg,jpeg,gif,docx,xlsx,pptx,odt,ods,odp,zip
# REPORT_VERIFY_ENABLED=True              # False turns the public /verify/ page off
# REPORT_VERIFY_MAX_BYTES=20971520
# REPORT_VERIFY_RATE_LIMIT=20             # requests per window per address
# REPORT_VERIFY_RATE_WINDOW_SECONDS=600
# MAX_REQUEST_BYTES=27262976              # 413 above this; also set it on the proxy

# Directory for uploaded evidence files. Leave unset to disable file
# uploads (links and reference notes still work). Must be persistent
# storage in production (a mounted volume).
# MEDIA_ROOT=/app/media

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://aavistin:aavistin@localhost:5432/aavistin

# Host-side ports docker-compose.yml publishes the web app and Postgres
# on (read by docker compose itself, not by Django) — change these if
# 8080/5432 are already taken on your machine. Only takes effect on
# `docker compose up`, after editing this file (or .env).
WEB_PORT=8080
DB_PORT=5432

# LDAP authentication is off by default (local accounts only).
# Set LDAP_ENABLED=True and the variables below to turn it on.
LDAP_ENABLED=False
# AUTH_LDAP_SERVER_URI=ldaps://ldap.example.org
# AUTH_LDAP_BIND_DN=cn=service-account,dc=example,dc=org
# AUTH_LDAP_BIND_PASSWORD=
# AUTH_LDAP_USER_SEARCH_BASE=ou=users,dc=example,dc=org
# AUTH_LDAP_USER_SEARCH_FILTER=(uid=%(user)s)
# AUTH_LDAP_GROUP_SEARCH_BASE=ou=groups,dc=example,dc=org
