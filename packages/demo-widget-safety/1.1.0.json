{
  "source": "demo-widget-safety",
  "type": "legislation",
  "jurisdiction": "EU",
  "version": "1.1.0",
  "title": "Demo Widget Safety Directive (fictional, for tests only)",
  "redistributable": true,
  "supersedes": [{ "source": "demo-widget-safety", "version": "1.0.0" }],
  "questions": [
    {
      "id": "has_power_source",
      "type": "boolean",
      "level": "hardware",
      "label": "Does the widget have a power source?"
    },
    {
      "id": "rated_power_watts",
      "type": "number",
      "level": "hardware",
      "label": "Rated power",
      "unit": "W"
    },
    {
      "id": "is_toy_widget",
      "type": "boolean",
      "level": "product",
      "label": "Is the widget marketed as a toy?"
    },
    {
      "id": "has_wireless",
      "type": "boolean",
      "level": "hardware",
      "label": "Does the widget have a wireless radio?"
    }
  ],
  "scope": {
    "include": { "var": "has_power_source" },
    "exclude": [
      {
        "id": "toy_widgets_excluded",
        "when": { "var": "is_toy_widget" },
        "ref": "Demo Art. 2(2)"
      }
    ]
  },
  "classifications": [
    {
      "id": "high_power",
      "label": "High power widget",
      "when": { ">": [{ "var": "rated_power_watts" }, 80] }
    }
  ],
  "requirements": [
    {
      "id": "provide_widget_manual",
      "label": "Provide a safety manual with the widget",
      "roles": ["manufacturer"],
      "ref": "Demo Art. 5"
    },
    {
      "id": "wireless_interference_test",
      "label": "Test the wireless radio for interference",
      "roles": ["manufacturer"],
      "ref": "Demo Art. 7"
    }
  ],
  "finding_rules": [
    {
      "id": "high_power_caution",
      "level": "caution",
      "when": { ">": [{ "var": "rated_power_watts" }, 80] },
      "message": "Rated power exceeds 80W; additional high-power safety requirements apply.",
      "ref": "Demo Art. 6"
    },
    {
      "id": "wireless_action_required",
      "level": "action_required",
      "when": { "var": "has_wireless" },
      "message": "Wireless radio present; interference testing is required before shipment.",
      "ref": "Demo Art. 7"
    }
  ],
  "fixtures": [
    {
      "id": "low_power_widget",
      "answers": {
        "has_power_source": true,
        "rated_power_watts": 20,
        "is_toy_widget": false,
        "has_wireless": false
      },
      "expected": { "in_scope": true, "findings": [] }
    },
    {
      "id": "high_power_widget",
      "answers": {
        "has_power_source": true,
        "rated_power_watts": 90,
        "is_toy_widget": false,
        "has_wireless": false
      },
      "expected": { "in_scope": true, "findings": ["high_power_caution"] }
    },
    {
      "id": "wireless_widget",
      "answers": {
        "has_power_source": true,
        "rated_power_watts": 20,
        "is_toy_widget": false,
        "has_wireless": true
      },
      "expected": { "in_scope": true, "findings": ["wireless_action_required"] }
    },
    {
      "id": "toy_widget_excluded",
      "answers": {
        "has_power_source": true,
        "rated_power_watts": 5,
        "is_toy_widget": true,
        "has_wireless": false
      },
      "expected": { "in_scope": false, "findings": [] }
    }
  ]
}
